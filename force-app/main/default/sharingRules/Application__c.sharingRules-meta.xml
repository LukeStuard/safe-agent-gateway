<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Gateway_Integration_Non_Draft</fullName>
        <accessLevel>Read</accessLevel>
        <description>Shares non-draft applications read-only with the Gateway Integration group. Draft applications are never visible to the agent gateway.</description>
        <label>Gateway Integration Non-Draft</label>
        <sharedTo>
            <group>Gateway_Integration</group>
        </sharedTo>
        <criteriaItems>
            <field>Status__c</field>
            <operation>notEqual</operation>
            <value>Draft</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
